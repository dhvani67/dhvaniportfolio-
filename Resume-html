<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{--paper:#FAF8F5;--panel:#F2EFEA;--ink:#1E1C1A;--ink-soft:#5A5550;--line:#DDD7CD;--accent:#A8443A;}
  *{margin:0;padding:0;box-sizing:border-box;}
  body{background:var(--paper);color:var(--ink);font-family:'Inter',sans-serif;font-size:9.6pt;line-height:1.55;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  a{color:var(--ink-soft);text-decoration:none;}

  .page{max-width:900px;margin:0 auto;padding:56px 60px 64px;background:var(--paper);}

  /* Header */
  .resume-header{display:grid;grid-template-columns:1fr auto;align-items:end;gap:32px;padding-bottom:22px;border-bottom:1.5px solid var(--ink);margin-bottom:36px;}
  .name{font-family:'Fraunces',serif;font-weight:400;font-size:34pt;letter-spacing:-0.025em;line-height:1;}
  .name em{font-style:italic;color:var(--accent);}
  .title-tag{font-size:7.5pt;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-soft);margin-top:8px;}
  .contact-block{text-align:right;font-size:8pt;color:var(--ink-soft);line-height:1.85;}

  /* Body */
  .body-grid{display:grid;grid-template-columns:1fr 210px;gap:48px;align-items:start;}

  /* Sections */
  .section{margin-bottom:28px;}
  .section-label{font-size:7.2pt;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);border-bottom:1px solid var(--line);padding-bottom:6px;margin-bottom:16px;}
  .overview{font-size:8.8pt;color:var(--ink-soft);line-height:1.7;}

  /* Entries */
  .entry{margin-bottom:18px;}
  .entry:last-child{margin-bottom:0;}
  .entry-header{display:flex;justify-content:space-between;align-items:baseline;gap:8px;flex-wrap:wrap;}
  .entry-title{font-family:'Fraunces',serif;font-weight:500;font-size:10.5pt;letter-spacing:-0.01em;}
  .entry-date{font-size:7.5pt;font-weight:700;letter-spacing:0.05em;color:var(--ink-soft);white-space:nowrap;flex-shrink:0;}
  .entry-org{font-size:8.2pt;color:var(--ink-soft);margin-top:2px;margin-bottom:7px;}
  .entry ul{padding-left:14px;}
  .entry ul li{font-size:8.5pt;color:var(--ink-soft);margin-bottom:4px;line-height:1.45;}

  /* Sidebar */
  .sidebar-section{margin-bottom:26px;}
  .skill-list{list-style:none;padding:0;}
  .skill-list li{font-size:8.5pt;color:var(--ink-soft);padding:6px 0;border-bottom:1px solid var(--line);line-height:1.3;}
  .skill-list li:last-child{border-bottom:none;}

  /* Print button */
  .print-btn{position:fixed;top:24px;right:24px;background:var(--ink);color:var(--paper);font-family:'Inter',sans-serif;font-size:0.8rem;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;border:none;padding:12px 22px;cursor:pointer;transition:background .2s;z-index:100;}
  .print-btn:hover{background:var(--accent);}

  /* Screen */
  @media screen{body{background:#E8E4DC;padding:40px 0;}.page{box-shadow:0 8px 32px rgba(30,28,26,0.18);}}

  /* Print */
  @media print{body{background:white;}.page{padding:36px 48px;max-width:100%;}@page{size:A4;margin:0;}.print-btn{display:none;}}
</style>
</head>
